# Le serveur de suivi n'expose que ses points d'entrée.
<FilesMatch "\.(md|sql|log|exemple\.php)$">
  Require all denied
</FilesMatch>

# En-tetes de securite. PHP les envoie lui-meme sur chaque reponse
# (lib/entetes.php, avec en plus la Content-Security-Policy a nonce des pages) ;
# ici, ils couvrent ce que PHP ne sert pas : le moteur JS copie dans prof/.
# « Header set » et non « Header always set » : « always » s'ajouterait aux
# en-tetes de PHP au lieu de les remplacer, et chaque reponse en porterait deux.
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "DENY"
  Header set Strict-Transport-Security "max-age=31536000"
</IfModule>

# Apache ne transmet pas l'en-tete Authorization a PHP en CGI/FastCGI (c'est le
# cas chez OVH) : sans cette regle, le jeton de session prof n'arrive jamais et
# toute action repond « session expiree ». La page envoie aussi le jeton dans le
# corps de la requete, cette regle est la deuxieme ceinture.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>
<IfModule mod_setenvif.c>
  SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
</IfModule>

Options -Indexes
