# Le serveur de suivi n'expose que ses points d'entrée.
<FilesMatch "\.(md|sql|log|exemple\.php)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Apache ne transmet pas l'en-tete Authorization a PHP en CGI/FastCGI (c'est le
# cas chez OVH) : sans cette regle, le jeton de session prof n'arrive jamais et
# toute action repond « session expiree ». La page envoie aussi le jeton dans le
# corps de la requete, cette regle est la deuxieme ceinture.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>
<IfModule mod_setenvif.c>
  SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
</IfModule>

Options -Indexes
