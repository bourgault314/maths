# Lot 4 (02/09/2026) : tout passe en HTTPS, et config.php n'est jamais servi.
#
# Deux conditions CUMULEES pour la redirection : chez OVH, TLS peut etre
# termine sur l'equilibreur (X-Forwarded-Proto) ou sur Apache (%{HTTPS}).
# Avec une seule des deux, on risque une boucle de redirection infinie.
# On ne redirige que si NI l'une NI l'autre ne dit « deja en HTTPS ».
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://suivi.mathsgo.re%{REQUEST_URI} [R=301,L]
</IfModule>

# Le mot de passe MySQL n'a jamais a sortir par HTTP, meme si PHP tombait.
#
# Lot serveur B (constat 6 du 05/09/2026) : <Files "config.php"> ne protegeait
# QUE ce nom exact. Un « config.php.bak » laisse par un editeur, un
# « config.old » range a la main avant une modification, un « config.php.txt »
# renomme pour le relire : chacun sort en clair, avec le mot de passe MySQL
# dedans, et aucun n'est du PHP interprete. FilesMatch "^config" les couvre
# tous — y compris ceux qu'on n'a pas encore imagines.
<FilesMatch "^config">
  Require all denied
</FilesMatch>

# Le serveur de suivi n'expose que ses points d'entrée.
<FilesMatch "\.(md|sql|log|exemple\.php)$">
  Require all denied
</FilesMatch>

# Lot serveur B (constat 5) : le menage de fin d'annee se lance par la tache
# planifiee OVH, en ligne de commande. Rien a ouvrir dans un navigateur. Il
# refusait deja lui-meme (404), mais en laissant PHP annoncer sa version au
# passage ; ici, Apache repond 403 sans meme appeler PHP. La tache planifiee
# passe par la ligne de commande : cette regle ne la gene pas.
<Files "menage.php">
  Require all denied
</Files>

# Lot 11 (05/09/2026) : le manifeste VERSION donne la liste de tous les fichiers
# du serveur avec leur empreinte. verifier.php le lit sur le DISQUE, jamais par
# HTTP : personne d'autre n'a a le telecharger. Idem pour un eventuel .user.ini.
<Files "VERSION">
  Require all denied
</Files>
<FilesMatch "^\.user\.ini$">
  Require all denied
</FilesMatch>

# En-tetes de securite. PHP les envoie lui-meme sur chaque reponse
# (lib/entetes.php, avec en plus la Content-Security-Policy a nonce des pages).
# Ici, SEULEMENT sur ce que PHP ne sert pas : le moteur JS copie dans prof/,
# et depuis le lot « serveur pro » 5a (25/10/2026) la charte suivi.css.
# nosniff sur la feuille de style : le navigateur ne l'acceptera que servie
# comme text/css, jamais un autre fichier deguise en feuille de style.
# Constate chez OVH le 30/08/2026 : une directive Header posee sur tout le
# dossier s'AJOUTE aux en-tetes envoyes par PHP au lieu de les remplacer, et
# chaque page en portait deux (« DENY, DENY »). D'ou le FilesMatch.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|webmanifest)$">
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set X-Frame-Options "DENY"
    Header set Strict-Transport-Security "max-age=31536000"
  </FilesMatch>
</IfModule>

# Apache ne transmet pas l'en-tete Authorization a PHP en CGI/FastCGI (c'est le
# cas chez OVH) : sans cette regle, le jeton de session prof n'arrive jamais et
# toute action repond « session expiree ». La page envoie aussi le jeton dans le
# corps de la requete, cette regle est la deuxieme ceinture.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>
<IfModule mod_setenvif.c>
  SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
</IfModule>

# Lot A « plus rapide » (21/11/2026) : un an de cache pour les fichiers dont
# l'adresse porte une empreinte (?v=...), et pour eux seuls.
# Les pages PHP calculent ce ?v= a chaque affichage : ce sont les 10 premiers
# caracteres du md5 du fichier sur le disque (suivi.css, code-en-cases.js,
# prof/*.js, vendor/katex-...). Un nouveau depot FTP change donc l'adresse, et
# le navigateur va chercher le nouveau fichier : l'ancien ne peut pas rester.
# Ce qui est appele SANS empreinte (favicon.ico, favicon.svg,
# apple-touch-icon.png, mathsgo-logo.png, les polices de KaTeX) ne recoit rien
# ici et garde le reglage d'OVH (15 minutes, constate le 21/11/2026).
# Les pages .php ne sont pas concernees : elles gardent le no-store qu'envoie
# PHP (lib/entetes.php, lib/reponse.php).
#
# En deux temps, chacun dans son <IfModule> (un module absent chez OVH ne doit
# jamais donner une erreur 500 sur tout le serveur) :
# 1. mod_rewrite pose le drapeau MG_EMPREINTE si l'adresse porte ?v= et que le
#    fichier existe vraiment (un 404 n'est jamais garde un an) ;
# 2. mod_headers n'ecrit le Cache-Control que si le drapeau est pose.
# Sans mod_rewrite, le drapeau n'est jamais pose : rien n'est mis en cache, ce
# qui est le comportement d'avant. Ni « expr= » ni <If> : ils dependent de la
# version d'Apache ; une variable d'environnement marche partout.
# L'en-tete Expires d'OVH (15 minutes) peut rester a cote : quand les deux sont
# la, le navigateur suit max-age et ignore Expires (norme HTTP, RFC 9111).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{QUERY_STRING} (^|&)v=[^&]+
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule \.(js|css|png|svg|woff2)$ - [E=MG_EMPREINTE:1]
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|png|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable" env=MG_EMPREINTE
  </FilesMatch>
</IfModule>

# Lot E « Arriver » (21/11/2026) : le manifeste de l'icône (app.webmanifest)
# doit partir avec son vrai type, sinon nosniff (ci-dessus) le ferait refuser.
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>

Options -Indexes
